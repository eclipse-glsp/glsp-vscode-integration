# Copy to `.env` to override the defaults of the e2e packages. All entries are optional.
# See e2e/workflow-vscode-e2e/README.md for the full list.

# Port of the Workflow GLSP server
GLSP_SERVER_PORT=8081

# `node` starts the bundled server; `java` expects an externally started one
GLSP_SERVER_TYPE=node

# Set to `true` to attach to a GLSP server started by hand, e.g. under a debugger
#GLSP_SERVER_EXTERNAL=true

# VS Code release the tests run against
#VSCODE_VERSION=1.101.0
